# Model Provider Configuration
# Choose between "openai" or "ollama"
# For Ollama, we'll use the OpenAI-compatible API
MODEL_PROVIDER=openai

# OpenAI API Configuration
# Using Ollama's OpenAI-compatible endpoint
OPENAI_API_KEY=ollama-placeholder-key
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:latest

# Ollama Configuration (for reference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Weather API Configuration (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=govindkm.sv@gmail.com
EMAIL_PASSWORD=kikqihnqsvedvfhu
EMAIL_USE_TLS=true
# Set to false for development if you encounter SSL issues
EMAIL_VERIFY_SSL=true
# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=agent_logs.log